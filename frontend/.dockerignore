# Docker ignore file for Next.js frontend
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
.next
out
dist

# Environment files
.env*.local
.env

# Development
.DS_Store
*.pem

# Testing
coverage
.nyc_output

# Production
*.prof
*.pid

# Debug
debug
*.log

# Local development
.vscode
.idea
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
.tmp
.temp

# Documentation
docs
*.md
!README.md

# Git
.git
.gitignore

# CI/CD
.github
.gitlab-ci.yml
.circleci
.travis.yml

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Backup files
*.bak
*.backup

# Lock files (we'll generate these during build)
package-lock.json
yarn.lock